# Copy this file to .env and fill it in. .env is gitignored and must stay that way.

# Both of these are safe to expose. The project id is in every Studio URL and the
# dataset name is public. They are only in a file because they change per project,
# and this is that project, so they are filled in: copying this file is enough.
SANITY_PROJECT_ID=y9oyffjn
SANITY_DATASET=production

# A read token. Only needed if the dataset is set to private. A public dataset
# needs no token at all, and a public dataset is the right default for a
# portfolio, because everything in it is going on a public website anyway.
#
# There is no write token here on purpose. Content is changed in the Studio,
# which signs you in as yourself, so nothing in this repo needs a key that could
# overwrite the dataset.
SANITY_READ_TOKEN=
