---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/content';

interface Props {
  title: string;
  description: string;
  active?: string;
  // Serialised JSON-LD, built per page in src/lib/schema.ts. One graph, so the
  // nodes in it can reference each other and describe one person.
  jsonLd?: string;
}

const { title, description, active, jsonLd } = Astro.props;
const settings = await getSettings();

// The canonical address comes from the CMS rather than from astro.config, so
// there is one place to change it and no chance of the two disagreeing. Every
// link preview on every social platform is built from these three tags, so a
// wrong value here is invisible on the site and wrong everywhere else.
const canonical = new URL(Astro.url.pathname, settings.domain).href;
const share = new URL('/og.jpg', settings.domain).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={share} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${settings.name}. ${settings.roleShort}.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={share} />

    <!-- The default is a snippet clipped at whatever length the engine feels
         like and a thumbnail. Both defaults cost citations on a site whose
         argument is carried by long answers and by pictures. -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content={settings.name} />

    <meta name="theme-color" content="#131820" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <link
      rel="preload"
      href="/fonts/Recursive_VF-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Redaction-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
