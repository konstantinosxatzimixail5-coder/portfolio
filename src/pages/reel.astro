---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import VideoFacade from '../components/VideoFacade.astro';
import { reel } from '../data/site';

// Until the cut is hosted, the page shows three frames from it instead of one
// poster. The source frames are portrait, so a single 16:9 still would crop.
const trio = [
  {
    src: 'spec/feral/product-05',
    alt: 'A FERAL Yuzu Static can standing in shallow water with magenta and green vapour behind it.',
  },
  {
    src: 'bike-barn/frame-01',
    alt: 'A rider on an Indian motorcycle on wet cobbles at night, canal houses and street lamps behind.',
  },
  {
    src: 'spec/knuckle/product-01',
    alt: 'A single amber KNUCKLE chew sliding out of a black leather sleeve, the flavour names stamped into it.',
  },
];

// What is in the cut, in order. Each shot says which piece it came from, which
// pipeline made it and what I did. Client and spec are marked separately.
const shots = [
  {
    t: '00:00',
    piece: 'Mariposa',
    kind: 'Client',
    pipeline: 'Phantom Set',
    role: 'Wrote, produced, cut. Also built the site it links to.',
  },
  {
    t: '00:12',
    piece: 'Bike Barn, Indian Elite',
    kind: 'Client',
    pipeline: 'Phantom Set',
    role: 'Plate, set specification, motion and cut.',
  },
  {
    t: '00:24',
    piece: 'COCOON, vector attack explainer',
    kind: 'Client',
    pipeline: 'Written and boarded by hand',
    role: 'Read the grant text, wrote the sequence, boarded and cut it.',
  },
  {
    t: '00:38',
    piece: 'Amino Alliance',
    kind: 'Client',
    pipeline: 'Identity Lock and Phantom Set',
    role: 'Trained both presenters, wrote the openings, ran the hand gate.',
  },
  {
    t: '00:50',
    piece: 'FERAL, Yuzu Static',
    kind: 'Spec, self-initiated',
    pipeline: 'Phantom Set and Identity Lock',
    role: 'Invented the brand, designed the can, built every frame.',
  },
  {
    t: '01:02',
    piece: 'KNUCKLE energy chews',
    kind: 'Spec, self-initiated',
    pipeline: 'Phantom Set',
    role: 'Invented the brand, the four flavours and the pack.',
  },
  {
    t: '01:14',
    piece: 'GRAIN 01',
    kind: 'Spec, self-initiated',
    pipeline: 'Identity Lock',
    role: 'Trained the creator, shot all three lighting conditions from one identity.',
  },
];
---

<Base
  title="Reel, Konstantinos Chatzimichail"
  description="Ninety seconds, and a list under it saying what each shot is, which pipeline made it and what my hand did on it."
  active="reel"
>
  <article class="reelpage">
    <header class="reelpage__head shell">
      <p class="mono faint">{reel.duration} · {reel.title}</p>
      <h1 class="reelpage__title">Reel</h1>
      <p class="reelpage__lede">
        One cut. Under it, every shot in order, with the piece it came from, the pipeline that made
        it and what I actually did.
      </p>
    </header>

    <div class="reelpage__player shell">
      {
        reel.id ? (
          <VideoFacade
            host={reel.host}
            videoId={reel.id}
            poster={reel.poster}
            alt={reel.posterAlt}
            title={reel.title}
            duration={reel.duration}
            loading="eager"
          />
        ) : (
          <div class="pending">
            <div class="pending__trio">
              {
                trio.map((f, i) => (
                  <Frame
                    src={f.src}
                    alt={f.alt}
                    num={String(i + 1).padStart(2, '0')}
                    ratio="3 / 4"
                    loading="eager"
                    sizes="(max-width: 900px) 33vw, 360px"
                  />
                ))
              }
            </div>
            <p class="mono pending__note">
              The cut is being assembled. The shot list below is the running order.
            </p>
          </div>
        )
      }
    </div>

    <section class="shell spread reelpage__list">
      <div class="rail">
        <span class="rail__num">01</span>
        <span class="rail__slug">Shot list</span>
      </div>

      <div>
        <h2 class="sec__h2">What is in it</h2>
        <ol class="shots">
          {
            shots.map((s) => (
              <li class="shot">
                <span class="mono shot__t faint">{s.t}</span>
                <span class="shot__piece">{s.piece}</span>
                <span
                  class={
                    s.kind === 'Client' ? 'mono shot__kind' : 'mono shot__kind shot__kind--spec'
                  }
                >
                  {s.kind}
                </span>
                <span class="mono mono--lower shot__pipe quiet">{s.pipeline}</span>
                <span class="shot__role quiet">{s.role}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <nav class="reelpage__back shell" aria-label="Back">
      <a class="mono" href="/">← Back to the front page</a>
    </nav>
  </article>
</Base>

<style>
  .reelpage__head {
    padding-top: var(--s-8);
    padding-bottom: var(--s-5);
    display: grid;
    gap: var(--s-3);
  }

  .reelpage__head > p:first-child {
    font-size: 0.66rem;
    max-width: none;
  }

  .reelpage__title {
    font-size: var(--step-5);
    letter-spacing: -0.03em;
  }

  .reelpage__lede {
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 42ch;
    color: var(--newsprint-dim);
  }

  .reelpage__player {
    padding-bottom: var(--s-7);
  }

  .pending {
    display: grid;
    gap: var(--s-3);
  }

  .pending__trio {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
  }

  .pending__note {
    font-size: 0.66rem;
    color: var(--gold);
    max-width: none;
  }

  .reelpage__list {
    padding-bottom: var(--s-8);
  }

  .sec__h2 {
    font-family: var(--mono);
    font-variation-settings: var(--rec-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
    font-weight: 500;
    margin-bottom: var(--s-4);
  }

  .shots {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-bright);
  }

  .shot {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) minmax(0, 10rem);
    grid-template-areas:
      't piece kind'
      't pipe  pipe'
      't role  role';
    gap: 0.15rem var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .shot__t {
    grid-area: t;
    font-size: 0.64rem;
    padding-top: 0.35rem;
  }

  .shot__piece {
    grid-area: piece;
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--newsprint);
  }

  .shot__kind {
    grid-area: kind;
    font-size: 0.6rem;
    color: var(--cyan);
    padding-top: 0.4rem;
  }

  .shot__kind--spec {
    color: var(--gold);
  }

  .shot__pipe {
    grid-area: pipe;
    font-size: 0.64rem;
  }

  .shot__role {
    grid-area: role;
    font-size: var(--step--1);
    max-width: 60ch;
  }

  @media (max-width: 620px) {
    .shot {
      grid-template-columns: 3.2rem minmax(0, 1fr);
      grid-template-areas:
        't piece'
        't kind'
        't pipe'
        't role';
    }
    .shot__kind {
      padding-top: 0.1rem;
    }
  }

  .reelpage__back {
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .reelpage__back a {
    text-decoration: none;
    font-size: 0.68rem;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
