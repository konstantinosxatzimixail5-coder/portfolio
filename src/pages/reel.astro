---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import VideoFacade from '../components/VideoFacade.astro';
import { getReel, getSettings } from '../lib/content';
import { breadcrumbs, collection, graph, person } from '../lib/schema';

// Everything on this page is edited in the Studio. While the cut is unhosted
// the video id is empty and the three frames stand in for the poster, because
// the source frames are portrait and a single wide still would crop them.
const [reel, site] = await Promise.all([getReel(), getSettings()]);
const shots = reel.shots ?? [];

// A VideoObject only goes in once there is a video. Describing an unhosted cut
// as one is the structured-data version of a page that pretends the reel exists,
// and the rest of this page is careful not to.
const jsonLd = graph([
  person(site.domain, site),
  collection(site.domain, '/reel/', reel.heading, reel.seoDescription),
  breadcrumbs(site.domain, [
    { name: 'Home', path: '/' },
    { name: 'Reel', path: '/reel/' },
  ]),
  ...(reel.videoId
    ? [
        {
          '@type': 'VideoObject',
          '@id': new URL('/reel/#video', site.domain).href,
          name: reel.title,
          description: reel.seoDescription,
          ...(reel.duration ? { duration: `PT${reel.duration.replace(':', 'M')}S` } : {}),
          embedUrl:
            reel.host === 'youtube'
              ? `https://www.youtube-nocookie.com/embed/${reel.videoId}`
              : `https://player.vimeo.com/video/${reel.videoId}`,
          creator: { '@id': new URL('/', site.domain).href + '#person' },
        },
      ]
    : []),
]);
---

<Base title={reel.seoTitle} description={reel.seoDescription} active="reel" jsonLd={jsonLd}>
  <article class="reelpage">
    <header class="reelpage__head shell">
      <p class="mono faint">{reel.duration} · {reel.title}</p>
      <h1 class="reelpage__title">{reel.heading}</h1>
      <p class="reelpage__lede">{reel.lede}</p>
    </header>

    <div class="reelpage__player shell">
      {
        reel.videoId ? (
          <VideoFacade
            host={reel.host}
            videoId={reel.videoId}
            poster={reel.poster}
            title={reel.title}
            duration={reel.duration}
            loading="eager"
          />
        ) : (
          <div class="pending">
            <div class="pending__trio">
              {reel.trio.map((f, i) => (
                <Frame
                  image={f}
                  num={String(i + 1).padStart(2, '0')}
                  ratio="3 / 4"
                  loading="eager"
                  sizes="(max-width: 900px) 33vw, 360px"
                />
              ))}
            </div>
            <p class="mono pending__note">{reel.pendingNote}</p>
          </div>
        )
      }
    </div>

    <section class="shell spread reelpage__list">
      <div class="rail">
        <span class="rail__num">01</span>
        <span class="rail__slug">{reel.shotsRail}</span>
      </div>

      <div>
        <h2 class="sec__h2">{reel.shotsHeading}</h2>
        <ol class="shots">
          {
            shots.map((s: any) => (
              <li class="shot">
                <span class="mono shot__t faint">{s.time}</span>
                <span class="shot__piece">{s.piece}</span>
                <span
                  class={
                    s.kind === 'Client' ? 'mono shot__kind' : 'mono shot__kind shot__kind--spec'
                  }
                >
                  {s.kind}
                </span>
                <span class="mono mono--lower shot__pipe quiet">{s.pipeline}</span>
                <span class="shot__role quiet">{s.role}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <nav class="reelpage__back shell" aria-label="Back">
      <a class="mono" href="/">← Back to the front page</a>
    </nav>
  </article>
</Base>

<style>
  .reelpage__head {
    padding-top: var(--s-8);
    padding-bottom: var(--s-5);
    display: grid;
    gap: var(--s-3);
  }

  .reelpage__head > p:first-child {
    font-size: 0.66rem;
    max-width: none;
  }

  .reelpage__title {
    font-size: var(--step-5);
    letter-spacing: -0.03em;
  }

  .reelpage__lede {
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 42ch;
    color: var(--newsprint-dim);
  }

  .reelpage__player {
    padding-bottom: var(--s-7);
  }

  .pending {
    display: grid;
    gap: var(--s-3);
  }

  .pending__trio {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
  }

  .pending__note {
    font-size: 0.66rem;
    color: var(--gold);
    max-width: none;
  }

  .reelpage__list {
    padding-bottom: var(--s-8);
  }

  .sec__h2 {
    font-family: var(--mono);
    font-variation-settings: var(--rec-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
    font-weight: 500;
    margin-bottom: var(--s-4);
  }

  .shots {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-bright);
  }

  .shot {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) minmax(0, 10rem);
    grid-template-areas:
      't piece kind'
      't pipe  pipe'
      't role  role';
    gap: 0.15rem var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .shot__t {
    grid-area: t;
    font-size: 0.64rem;
    padding-top: 0.35rem;
  }

  .shot__piece {
    grid-area: piece;
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--newsprint);
  }

  .shot__kind {
    grid-area: kind;
    font-size: 0.6rem;
    color: var(--cyan);
    padding-top: 0.4rem;
  }

  .shot__kind--spec {
    color: var(--gold);
  }

  .shot__pipe {
    grid-area: pipe;
    font-size: 0.64rem;
  }

  .shot__role {
    grid-area: role;
    font-size: var(--step--1);
    max-width: 60ch;
  }

  @media (max-width: 620px) {
    .shot {
      grid-template-columns: 3.2rem minmax(0, 1fr);
      grid-template-areas:
        't piece'
        't kind'
        't pipe'
        't role';
    }
    .shot__kind {
      padding-top: 0.1rem;
    }
  }

  .reelpage__back {
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .reelpage__back a {
    text-decoration: none;
    font-size: 0.68rem;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
