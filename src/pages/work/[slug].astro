---
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import Clips from '../../components/Clips.astro';
import RichText from '../../components/RichText.astro';
import CaseFigures from '../../components/CaseFigures.astro';
import { getWork, getSettings, clipsForAsync } from '../../lib/content';
import { breadcrumbs, caseStudy, graph, person } from '../../lib/schema';

export async function getStaticPaths() {
  // The query already drops drafts and sorts by the order field.
  const entries = await getWork();
  return entries.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      d: entry,
      prev: entries[i - 1] ?? entries[entries.length - 1],
      next: entries[i + 1] ?? entries[0],
    },
  }));
}

const { d, prev, next } = Astro.props;
const site = await getSettings();

const spec = d.kind === 'Spec, self-initiated';

// The films from this engagement that a reader can actually watch. The Studio's
// own video field still plays first; these are added under it rather than
// instead of it. See src/data/videos.ts.
const films = await clipsForAsync(`work:${d.slug}`);
const hasMedia = d.gallery.length > 0 || !!d.video || films.length > 0;
const fullCase = !!(d.problemBody && d.idea && d.made && d.result && d.artefacts && d.gates);

// Commercial cases carry the complete working record: idea, outputs, controls,
// handover files and tools. Older and self-initiated pages keep the original
// five-part structure until their source material can support the same depth.
const sections = fullCase
  ? [
      { id: 'problem', label: 'Problem', body: d.problemBody },
      { id: 'idea', label: 'Idea', body: d.idea },
      { id: 'made', label: 'What I made', items: d.made },
      { id: 'result', label: 'Result', body: d.result },
      { id: 'how', label: 'How I built it', body: d.how },
      { id: 'artefacts', label: 'Artefacts', artefacts: d.artefacts },
      { id: 'gates', label: 'Gates', gates: d.gates },
      { id: 'stack', label: 'Stack', stack: d.stack },
      ...(hasMedia ? [{ id: 'frames', label: 'Frames & films' }] : []),
    ]
  : [
      { id: 'brief', label: 'Brief', body: d.brief },
      { id: 'constraint', label: 'Constraint', body: d.constraint },
      { id: 'built', label: 'What I built', body: d.built },
      { id: 'how', label: 'How I built it', body: d.how },
      { id: 'landed', label: 'Where it landed', body: d.landed },
    ];

const jsonLd = graph([
  person(site.domain, site),
  caseStudy(site.domain, d),
  breadcrumbs(site.domain, [
    { name: 'Home', path: '/' },
    { name: 'Selected work', path: '/#work' },
    { name: d.title, path: `/work/${d.slug}/` },
  ]),
]);
---

<Base
  title={`${d.title}, ${site.name}`}
  description={d.problem}
  active="work"
  jsonLd={jsonLd}
>
  <article class="cs">
    <!-- header -->
    <header class="cs__head shell">
      <p class="cs__meta mono">
        <span class={spec ? 'cs__kind cs__kind--spec' : 'cs__kind'}>{d.kind}</span>
        <span class="faint" aria-hidden="true">·</span>
        <span class="quiet">{d.year}</span>
        {
          d.place && (
            <>
              <span class="faint" aria-hidden="true">
                ·
              </span>
              <span class="quiet">{d.place}</span>
            </>
          )
        }
      </p>
      <h1 class="cs__title">{d.title}</h1>
      {d.caseTitle && <p class="cs__case-title">{d.caseTitle}</p>}
      <p class="cs__problem">{d.problem}</p>
      {
        d.figures?.length > 0 && (
          <CaseFigures label={d.figureLabel ?? 'Project figures'} figures={d.figures} />
        )
      }
    </header>

    <!-- lead image -->
    <div class="cs__lead shell">
      <Frame image={d.hero} num="01" loading="eager" sizes="(max-width: 900px) 100vw, 1100px" />
    </div>

    <!-- skeleton -->
    <div class="cs__body shell spread">
      <!-- the strip, drawn small, as the section index -->
      <nav class="index" aria-label="Sections">
        <ol class="index__list">
          {
            sections.map((s, i) => (
              <li class="index__item">
                <a href={`#${s.id}`} class="index__link" data-index-link={s.id}>
                  <span class="index__dot" aria-hidden="true" />
                  <span class="index__label mono">{String(i + 1).padStart(2, '0')} {s.label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="cs__prose">
        {
          sections.map((s) => (
            <section class={`cs__sec cs__sec--${s.id}`} id={s.id} data-section={s.id}>
              <h2 class="cs__h2">{s.label}</h2>
              {s.body && <RichText value={s.body} />}

              {s.id === 'made' && s.items?.length > 0 && (
                <ul class="made-list">
                  {s.items.map((item: string) => (
                    <li><span aria-hidden="true">→</span><span>{item}</span></li>
                  ))}
                </ul>
              )}

              {s.id === 'artefacts' && s.artefacts?.length > 0 && (
                <dl class="artefacts">
                  {s.artefacts.map((item: any) => (
                    <div class="artefacts__row">
                      <dt class="mono">{item.label}</dt>
                      <dd>{item.value}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {s.id === 'gates' && s.gates?.length > 0 && (
                <div class="gates">
                  {s.gates.map((gate: any, i: number) => (
                    <article class="gate">
                      <p class="mono gate__num">Gate {String(i + 1).padStart(2, '0')}</p>
                      <h3>{gate.name}</h3>
                      <p>{gate.test}</p>
                    </article>
                  ))}
                </div>
              )}

              {s.id === 'stack' && s.stack?.length > 0 && (
                <div class="stack">
                  <dl class="stack__list">
                    {s.stack.map((row: any) => (
                      <div class="stack__row">
                        <dt class="mono">{row.stage}</dt>
                        <dd class="mono mono--lower">{row.tool}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}

              {(s.id === 'built' || s.id === 'frames') && d.gallery.length > 0 && (
                <div class="cs__strip">
                  {d.gallery.map((g: any, i: number) => (
                    <Frame
                      image={g}
                      num={String(i + 2).padStart(2, '0')}
                      ratio="1 / 1"
                      sizes="(max-width: 700px) 45vw, 22vw"
                    />
                  ))}
                </div>
              )}

              {(s.id === 'built' || s.id === 'frames') && d.video && (
                <div class="cs__video">
                  <VideoFacade
                    host={d.video.host}
                    videoId={d.video.videoId}
                    poster={d.video.poster}
                    title={d.video.title}
                    duration={d.video.duration}
                  />
                </div>
              )}

              {(s.id === 'built' || s.id === 'frames') && films.length > 0 && (
                <div class="cs__video">
                  <Clips
                    clips={films}
                    heading={films.length > 1 ? `${films.length} films from this one` : undefined}
                  />
                </div>
              )}

              {!fullCase && s.id === 'how' && d.stack.length > 0 && (
                <div class="stack">
                  <p class="mono stack__head">Stack, stage by stage</p>
                  <dl class="stack__list">
                    {d.stack.map((row: any) => (
                      <div class="stack__row">
                        <dt class="mono">{row.stage}</dt>
                        <dd class="mono mono--lower">{row.tool}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}

              {((fullCase && s.id === 'result') || (!fullCase && s.id === 'landed')) && d.links.length > 0 && (
                <ul class="cs__links">
                  {d.links.map((l: any) => (
                    <li>
                      <a href={l.href} class="cs__link mono" rel="noopener">
                        {l.label}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>
    </div>

    <!-- pager -->
    <nav class="pager shell" aria-label="More work">
      <a class="pager__link" href={`/work/${prev.slug}/`}>
        <span class="mono faint">← Previous</span>
        <span class="pager__title">{prev.title}</span>
      </a>
      <a class="pager__link pager__link--next" href={`/work/${next.slug}/`}>
        <span class="mono faint">Next →</span>
        <span class="pager__title">{next.title}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .cs__head {
    padding-top: var(--s-8);
    padding-bottom: var(--s-5);
    display: grid;
    gap: var(--s-3);
  }

  .cs__meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.68rem;
    margin: 0;
    max-width: none;
  }
  .cs__kind {
    color: var(--cyan);
  }
  .cs__kind--spec {
    color: var(--gold);
  }

  .cs__title {
    font-size: var(--step-5);
    letter-spacing: -0.025em;
  }

  .cs__case-title {
    font-family: var(--display);
    font-size: clamp(var(--step-1), 3vw, var(--step-3));
    line-height: 1.08;
    max-width: 24ch;
    color: var(--newsprint);
  }

  .cs__problem {
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 38ch;
    color: var(--fg-quiet);
  }

  .cs__lead {
    padding-bottom: var(--s-7);
  }

  .cs__body {
    padding-bottom: var(--s-8);
  }

  /* --- section index (the strip, vertical) -------------------------------- */

  .index {
    position: sticky;
    top: 5rem;
    padding-top: 0.4rem;
  }

  .index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    position: relative;
  }

  .index__list::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: var(--rule-bright);
  }

  .index__link {
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr);
    gap: 0.55rem;
    align-items: start;
    padding-block: 0.5rem;
    text-decoration: none;
    color: var(--fg-faint);
  }

  .index__dot {
    width: 7px;
    height: 7px;
    margin-top: 0.42rem;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: inset 0 0 0 1px var(--rule-bright);
    transition:
      background var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .index__label {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    line-height: 1.4;
  }

  .index__link:hover,
  .index__link.is-current {
    color: var(--newsprint);
  }

  .index__link:hover .index__dot,
  .index__link.is-current .index__dot {
    background: var(--cyan);
    box-shadow: inset 0 0 0 1px var(--cyan);
  }

  @media (max-width: 900px) {
    .index {
      display: none;
    }
  }

  /* --- prose -------------------------------------------------------------- */

  .cs__prose {
    display: grid;
    gap: var(--s-8);
    min-width: 0;
  }

  .cs__sec {
    display: grid;
    gap: var(--s-4);
    scroll-margin-top: 5rem;
  }

  .cs__h2 {
    font-family: var(--mono);
    font-variation-settings: var(--rec-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
    font-weight: 500;
  }

  /* The paragraphs are rendered by RichText, a child component, so a scoped
     selector never reaches them. These have to be global, held inside .cs__sec. */
  .cs__sec :global(p) {
    font-size: var(--step-0);
    max-width: var(--measure);
  }

  /* The constraint is the line that matters most, so it is set apart. */
  .cs__sec--constraint {
    border-left: 2px solid var(--red);
    padding-left: var(--s-5);
  }

  .cs__sec--constraint .cs__h2 {
    color: var(--red);
  }

  .cs__sec--constraint :global(p) {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.42;
    color: var(--newsprint);
    max-width: 46ch;
  }

  .cs__sec--idea {
    border-left: 2px solid var(--red);
    padding-left: var(--s-5);
  }

  .cs__sec--idea .cs__h2 {
    color: var(--red);
  }

  .cs__sec--idea :global(p) {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.42;
    color: var(--newsprint);
    max-width: 48ch;
  }

  .made-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-3);
    max-width: var(--measure);
  }

  .made-list li {
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr);
    gap: var(--s-2);
    font-size: var(--step-0);
    line-height: 1.55;
  }

  .made-list li > :first-child {
    color: var(--red);
  }

  .artefacts {
    margin: 0;
    border-top: 1px solid var(--rule-bright);
  }

  .artefacts__row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.34fr) minmax(0, 1fr);
    gap: var(--s-5);
    align-items: baseline;
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }

  .artefacts__row dt {
    color: var(--red);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .artefacts__row dd {
    margin: 0;
    color: var(--fg-quiet);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .gates {
    display: grid;
    gap: var(--s-3);
  }

  .gate {
    position: relative;
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-5);
    background: var(--ink-raised);
    border-left: 2px solid var(--red);
  }

  .gate::after {
    content: '';
    position: absolute;
    inset: 0 0 auto auto;
    width: 2.75rem;
    height: 1px;
    background: var(--red);
  }

  .gate__num {
    margin: 0;
    color: var(--red);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .gate h3 {
    font-family: var(--body);
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--newsprint);
  }

  .gate p:last-child {
    margin: 0;
    color: var(--fg-quiet);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: 64ch;
  }

  @media (max-width: 620px) {
    .cs__sec--constraint,
    .cs__sec--idea {
      padding-left: var(--s-4);
    }

    .artefacts__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-1);
    }
  }

  /* --- frame strip -------------------------------------------------------- */

  .cs__strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .cs__video {
    margin-top: var(--s-4);
  }

  /* --- stack -------------------------------------------------------------- */

  .stack {
    margin-top: var(--s-3);
    background: var(--ink-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--s-4) var(--s-5);
  }

  .stack__head {
    color: var(--fg-faint);
    font-size: 0.62rem;
    margin-bottom: var(--s-3);
  }

  .stack__list {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .stack__row {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: var(--s-2);
    border-top: 1px solid var(--rule);
  }
  .stack__row:first-child {
    border-top: 0;
  }

  .stack__row dt {
    color: var(--fg-quiet);
    font-size: 0.64rem;
  }
  .stack__row dd {
    margin: 0;
    color: var(--mint);
    font-size: 0.8rem;
  }

  @media (max-width: 560px) {
    .stack__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }

  /* --- links -------------------------------------------------------------- */

  .cs__links {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .cs__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--s-4);
    border: 1px solid var(--cyan);
    border-radius: var(--radius);
    color: var(--cyan);
    text-decoration: none;
  }

  .cs__link:hover {
    background: var(--cyan);
    color: var(--ink);
  }

  /* --- pager -------------------------------------------------------------- */

  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    justify-content: space-between;
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .pager__link {
    display: grid;
    gap: var(--s-1);
    text-decoration: none;
    color: inherit;
    min-height: var(--tap);
  }

  .pager__link--next {
    text-align: right;
    justify-items: end;
  }

  .pager__title {
    font-family: var(--display);
    font-size: var(--step-1);
    color: var(--newsprint);
  }

  .pager__link:hover .pager__title {
    color: var(--cyan);
  }
</style>

<script>
  // Fill the section index as the reader moves down the page.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-index-link]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-section]'));
  if (links.length && sections.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const id = (e.target as HTMLElement).dataset.section;
          links.forEach((l) => l.classList.toggle('is-current', l.dataset.indexLink === id));
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
