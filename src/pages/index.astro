---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import WorkCard from '../components/WorkCard.astro';
import Strip from '../components/Strip.astro';
import RichText from '../components/RichText.astro';
import { getHome, getSettings, getWork, getPipelines, getReel } from '../lib/content';
import { fill, Words } from '../lib/text';

const [home, site, work, pipelines, reel] = await Promise.all([
  getHome(),
  getSettings(),
  getWork(),
  getPipelines(),
  getReel(),
]);

// The three frames from the cut belong to the reel, not to this page, so both
// places show the same pictures and there is one row to change.
const reelTrio = reel.trio;

// Numbers written into the copy are counted here instead of typed, because a
// typed number stays a valid sentence long after it stops being true.
const counts = { count: work.length };

// The contents index and the labels down the left margin are the same six
// sections, so they read from one list. Numbering them twice is how 02 in the
// index ends up next to 03 in the margin.
const byHref = new Map<string, any>((home.contents ?? []).map((c: any) => [c.href, c]));

const mark = (href: string) => {
  const row = byHref.get(href);
  if (!row) {
    throw new Error(
      `The front page has a "${href}" section but no row for it in the contents index. Add one in the Studio, under Home page, Contents index.`
    );
  }
  return row;
};
---

<Base title={home.seoTitle} description={home.seoDescription} active="home">
  <!-- ============================================================ 00 open -->
  <section class="open shell">
    <p class="mono open__slug faint">
      {site.role}
      <span class="open__sep" aria-hidden="true">/</span>
      {site.base}
    </p>

    <div class="open__top">
      <div class="open__say">
        <h1 class="open__line">{home.headline}</h1>

        <p class="open__lede">{home.lede}</p>

        <p class="open__note quiet">{home.note}</p>
      </div>

      <Frame
        class="open__face"
        image={home.openImage}
        num="00"
        ratio="1 / 2"
        loading="eager"
        sizes="(max-width: 900px) 60vw, 300px"
      />
    </div>

    <!-- the contents index -->
    <nav class="toc" aria-label="Contents">
      <ol class="toc__list">
        {
          (home.contents ?? []).map((c: any) => (
            <li class="toc__item">
              <a class="toc__row" href={c.href}>
                <span class="toc__num mono">{c.num}</span>
                <span class="toc__label">{c.label}</span>
                <span class="toc__note mono mono--lower faint">{fill(c.note, counts)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <!-- ============================================================ 01 reel -->
  <section id="reel" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#reel').num}</span>
      <span class="rail__slug">{mark('#reel').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{home.reelHeading}</h2>

      <a class="reel" href="/reel/">
        <span class="reel__trio">
          {
            reelTrio.map((f, i) => (
              <Frame
                image={f}
                num={String(i + 1).padStart(2, '0')}
                ratio="3 / 4"
                loading="eager"
                sizes="(max-width: 700px) 33vw, 300px"
              />
            ))
          }
        </span>
        <span class="reel__badge mono">
          {reel.videoId ? home.reelBadgePlay : home.reelBadgePending}
          <span aria-hidden="true"> →</span>
        </span>
      </a>

      <p class="quiet reel__note">{home.reelNote}</p>
    </div>
  </section>

  <!-- ============================================================ 02 work -->
  <section id="work" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#work').num}</span>
      <span class="rail__slug">{mark('#work').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{home.workHeading}</h2>
      <div class="grid">
        {
          work.map((e: any, i: number) => (
            <WorkCard
              href={`/work/${e.slug}/`}
              num={String(i + 1).padStart(2, '0')}
              client={e.client}
              kind={e.kind}
              problem={e.problem}
              image={e.hero}
              year={e.year}
            />
          ))
        }
      </div>

      <RichText value={home.workMore} class="quiet more" />
    </div>
  </section>

  <!-- ======================================================= 03 pipelines -->
  <section id="pipelines" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#pipelines').num}</span>
      <span class="rail__slug">{mark('#pipelines').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{home.pipelinesHeading}</h2>
      <p class="pipes__intro">{fill(home.pipelinesIntro, { pipelines: Words(pipelines.length) })}</p>

      <div class="pipes">
        {pipelines.map((p: any) => <Strip {...p} />)}
      </div>
    </div>
  </section>

  <!-- ========================================================= 04 writing -->
  <section id="writing" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#writing').num}</span>
      <span class="rail__slug">{mark('#writing').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{home.writingHeading}</h2>
      <dl class="write">
        {
          (home.writingItems ?? []).map((w: any) => (
            <div class="write__row">
              <dt>{w.title}</dt>
              <dd class="quiet">{w.note}</dd>
            </div>
          ))
        }
      </dl>
      {
        home.writingStudio && (
          <div class="studio">
            <p class="mono studio__flag">{home.writingStudio.flag}</p>
            <h3 class="studio__title">{home.writingStudio.title}</h3>
            <p class="quiet studio__note">{home.writingStudio.note}</p>
            <a class="btn btn--ghost mono studio__link" href={home.writingStudio.link.href} rel="noopener">
              {home.writingStudio.link.label}
              <span aria-hidden="true"> ↗</span>
            </a>
          </div>
        )
      }

      {home.writingMore && <p class="quiet more">{home.writingMore}</p>}
    </div>
  </section>

  <!-- =========================================================== 05 about -->
  <section id="about" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#about').num}</span>
      <span class="rail__slug">{mark('#about').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{home.aboutHeading}</h2>

      <div class="about__prose">
        <RichText value={home.aboutBody} />
      </div>

      <ul class="contact">
        <li><a class="btn mono" href={`mailto:${site.email}`}>Email me</a></li>
        {
          site.cv && (
            <li>
              <a class="btn btn--ghost mono" href={site.cv} download>
                Download CV<span aria-hidden="true"> ↓</span>
              </a>
            </li>
          )
        }
        {
          site.studio?.href && (
            <li>
              <a class="btn btn--ghost mono" href={site.studio.href} rel="noopener">
                {site.studio.label}
                <span aria-hidden="true"> ↗</span>
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* --- 00 open ------------------------------------------------------------ */

  .open {
    padding-top: var(--s-8);
    padding-bottom: var(--s-7);
  }

  .open__slug {
    font-size: 0.66rem;
    max-width: none;
    margin-bottom: var(--s-6);
  }

  .open__sep {
    color: var(--red);
    padding-inline: 0.35rem;
  }

  /* Headline left, one trained creator on the right, so the first screen
     carries a picture as well as a claim. */
  .open__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 19rem);
    gap: var(--s-6);
    align-items: end;
  }

  .open__line {
    font-size: var(--step-5);
    letter-spacing: -0.03em;
    max-width: 17ch;
    margin-bottom: var(--s-5);
  }

  @media (max-width: 900px) {
    .open__top {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }
    .open__face {
      max-width: 15rem;
    }
  }

  .open__lede {
    font-size: var(--step-1);
    line-height: 1.42;
    max-width: 44ch;
    color: var(--newsprint-dim);
  }

  .open__note {
    margin-top: var(--s-3);
    font-size: var(--step--1);
    max-width: 46ch;
  }

  /* --- the contents index ------------------------------------------------- */

  .toc {
    margin-top: var(--s-7);
    border-top: 1px solid var(--rule-bright);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 15rem) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-3);
    min-height: var(--tap);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  /* A red bar that runs the width of the row on hover. This is the one place
     the page raises its voice. */
  .toc__row::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 0;
    background: var(--red);
    transition: width 340ms var(--ease);
  }

  .toc__row:hover::after,
  .toc__row:focus-visible::after {
    width: 100%;
  }

  .toc__num {
    color: var(--red);
    font-size: 0.66rem;
  }

  .toc__label {
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--newsprint);
    transition: color var(--dur) var(--ease);
  }

  .toc__row:hover .toc__label {
    color: var(--cyan);
  }

  .toc__note {
    font-size: 0.66rem;
    max-width: none;
  }

  @media (max-width: 760px) {
    .toc__row {
      grid-template-columns: 2.2rem minmax(0, 1fr);
      gap: 0.15rem var(--s-3);
      padding-block: var(--s-3);
    }
    .toc__num {
      grid-row: span 2;
    }
    .toc__note {
      grid-column: 2;
    }
  }

  /* --- shared section furniture ------------------------------------------- */

  .stack-block {
    display: grid;
    gap: var(--s-5);
    min-width: 0;
  }

  .sec__h2 {
    font-family: var(--mono);
    font-variation-settings: var(--rec-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
    font-weight: 500;
  }

  .more {
    font-size: var(--step--1);
  }

  /* --- 01 reel ------------------------------------------------------------ */

  .reel {
    display: block;
    position: relative;
    text-decoration: none;
  }

  .reel__trio {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
  }

  .reel :global(.frame__plate) {
    transition: border-color var(--dur) var(--ease);
  }

  .reel:hover :global(.frame__plate) {
    border-color: var(--cyan);
  }

  .reel__badge {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-4);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--s-4);
    background: var(--ink);
    border: 1px solid var(--cyan);
    color: var(--cyan);
    font-size: 0.66rem;
  }

  .reel:hover .reel__badge {
    background: var(--cyan);
    color: var(--ink);
  }

  .reel__note {
    font-size: var(--step--1);
  }

  /* --- 02 work ------------------------------------------------------------ */

  /* Six projects, so two up. Three up shrinks every image for nothing, and the
     count has to stay even or the last row leaves an orphan. */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* --- 03 pipelines ------------------------------------------------------- */

  .pipes__intro {
    font-size: var(--step-0);
    color: var(--newsprint-dim);
    max-width: var(--measure);
  }

  .pipes {
    display: grid;
    gap: var(--s-8);
  }

  /* --- 04 writing --------------------------------------------------------- */

  .write {
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }

  .write__row {
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }

  .write__row dt {
    font-family: var(--display);
    font-size: var(--step-1);
    color: var(--newsprint);
    line-height: 1.2;
  }

  .write__row dd {
    margin: 0;
    font-size: var(--step--1);
  }

  @media (max-width: 620px) {
    .write__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }

  /* The blog. It sits under the list rather than inside it because it is the
     only writing here with an address, and a row that is also a link would be
     the odd one out in a list of four that are not. The heading is set at the
     size of the titles above it: a different kind of writing, not a louder one. */
  .studio {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    padding: var(--s-4) var(--s-5);
    background: var(--ink-raised);
    border: 1px solid var(--rule);
    border-left: 2px solid var(--gold);
    border-radius: var(--radius);
  }

  .studio__flag {
    color: var(--gold);
    font-size: 0.62rem;
    max-width: none;
  }

  .studio__title {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--newsprint);
    max-width: 26ch;
  }

  .studio__note {
    font-size: var(--step--1);
    max-width: var(--measure);
  }

  .studio__link {
    margin-top: var(--s-2);
  }

  /* --- 05 about ----------------------------------------------------------- */

  /* The paragraphs here are rendered inside RichText, so they never carry this
     component's scope attribute and cannot be selected by class from out here.
     Styling them through a wrapper is what makes the rule land. */
  .about__prose :global(p) {
    font-size: var(--step-0);
    max-width: var(--measure);
  }

  /* The opening paragraph carries the section, anything after it is a footnote
     to it. Done in CSS rather than as a class on the second paragraph, because
     the paragraphs come from the CMS now and an editor should be able to add a
     third one without being told to know that. */
  .about__prose :global(p ~ p) {
    color: var(--fg-quiet);
  }

  .contact {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: var(--tap);
    padding: 0 var(--s-4);
    border: 1px solid var(--cyan);
    background: var(--cyan);
    color: var(--ink);
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.66rem;
  }

  .btn--ghost {
    background: transparent;
    color: var(--cyan);
  }

  .btn:hover {
    background: var(--red);
    border-color: var(--red);
    color: var(--ink);
  }
</style>
