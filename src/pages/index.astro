---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import WorkCard from '../components/WorkCard.astro';
import Strip from '../components/Strip.astro';
import RichText from '../components/RichText.astro';
import WhatsApp from '../components/WhatsApp.astro';
import {
  getHome,
  getSettings,
  getWork,
  getReel,
  getSpecPage,
  getSpecBrands,
  getAllPipelines,
  findPipeline,
  HOME_PIPELINE,
  films,
  captures,
  faqs,
  featuredWriting,
  pairFor,
  writingSamples,
  writingGroups,
  profile,
  leadWork,
  tailWork,
  clipFor,
  blog,
} from '../lib/content';
import { composeSections, headingFor } from '../data/sections';
import { fill, words, Words } from '../lib/text';
import { breadcrumbs, faqPage, graph, person, website } from '../lib/schema';

const [home, site, work, allPipelines, reel, specPage, specBrands, lead] = await Promise.all([
  getHome(),
  getSettings(),
  getWork(),
  getAllPipelines(),
  getReel(),
  getSpecPage(),
  getSpecBrands(),
  findPipeline(HOME_PIPELINE),
]);

// One pipeline on the page, in full, and the other six as rows underneath. The
// one is the product photography line, and it reads directly under the shelf it
// produced: the shelf makes the claim, the line shows the work behind it. A missing slug is a wiring error worth failing on: the
// alternative is a front page that silently drops its only diagram.
if (!lead) {
  throw new Error(
    `HOME_PIPELINE is "${HOME_PIPELINE}" and no pipeline has that slug. ` +
      `Check src/data/pipelines.ts against the slugs in the Studio.`
  );
}
const restOfPipelines = allPipelines.filter((p: any) => p.id !== HOME_PIPELINE);

// The three frames from the cut belong to the reel, not to this page, so both
// places show the same pictures and there is one row to change.
const reelTrio = reel.trio;

// Whether there is a cut to play, from the Studio or from src/data/videos.ts.
// The badge says "play" or "coming" off this and nothing else.
const reelIsUp = !!(reel.videoId || clipFor('reel'));

// Numbers written into the copy are counted here instead of typed, because a
// typed number stays a valid sentence long after it stops being true.
const counts = {
  count: work.length,
  samples: writingSamples.length,
  frames: captures.length,
  brands: Words(specBrands.length),
  pipelines: Words(allPipelines.length),
};

// The index down the front page and the labels down the left margin are the
// same list, numbered from position rather than by hand. See src/data/sections.ts.
const index = composeSections(home.contents);
const mark = (href: string) => {
  const row = index.find((s) => s.href === href);
  if (!row) throw new Error(`No section defined for "${href}" in src/data/sections.ts.`);
  return row;
};

// Four of the eight on the front page. The rest are one click away, and a front
// page that shows all of them has stopped choosing.
const captureLead = captures.slice(0, 4);

// The two written samples that stand here, and everything else as a plain list
// underneath, so the shelf reads as a shelf rather than as two recommendations.
const restOfWriting = writingSamples.filter((s) => !s.featured);

// Sites built and shipped, shown as work and not claimed as anything else.
const shipped = [
  {
    label: 'talecrafters.studio',
    href: 'https://talecrafters.studio/',
    note: 'Studio site. Design, build and copy.',
  },
  {
    label: 'mariposa.restaurant',
    href: 'https://mariposa.restaurant/',
    note: 'Restaurant site for the kitchen in the case study above.',
  },
];

const jsonLd = graph([
  person(site.domain, site),
  website(site.domain, site),
  faqPage(site.domain),
  breadcrumbs(site.domain, [{ name: 'Home', path: '/' }]),
]);
---

<Base title={home.seoTitle} description={home.seoDescription} active="home" jsonLd={jsonLd}>
  <!-- ============================================================ 00 open -->
  <section class="open shell">
    <p class="mono open__slug">
      <span class="open__role">{site.role}</span>
      <span class="open__base">{site.base}</span>
    </p>

    <div class="open__top">
      <div class="open__say">
        <h1 class="open__line">{home.headline}</h1>

        <p class="open__lede">{home.lede}</p>

        <p class="open__claim">{site.claim}</p>

        <p class="open__note quiet">{home.note}</p>
      </div>

      <Frame
        class="open__face"
        image={home.openImage}
        num="00"
        ratio="1 / 2"
        loading="eager"
        sizes="(max-width: 900px) 60vw, 300px"
      />
    </div>

    <!-- the contents index -->
    <nav class="toc" aria-label="Contents">
      <ol class="toc__list">
        {
          index.map((c) => (
            <li class="toc__item">
              <a class="toc__row" href={c.href}>
                <span class="toc__num mono">{c.num}</span>
                <span class="toc__label">{c.label}</span>
                <span class="toc__note mono mono--lower faint">{fill(c.note, counts)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <!-- ============================================================ 01 reel -->
  <section id="reel" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#reel').num}</span>
      <span class="rail__slug">{mark('#reel').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{home.reelHeading}</h2>

      <a class="reel" href="/reel/">
        <span class="reel__trio">
          {
            reelTrio.map((f, i) => (
              <Frame
                image={f}
                num={String(i + 1).padStart(2, '0')}
                ratio="3 / 4"
                loading="eager"
                sizes="(max-width: 700px) 33vw, 300px"
              />
            ))
          }
        </span>
        <span class="reel__badge mono">
          {reelIsUp ? home.reelBadgePlay : home.reelBadgePending}
          <span aria-hidden="true"> →</span>
        </span>
      </a>

      <p class="quiet reel__note">{home.reelNote}</p>
    </div>
  </section>

  <!-- ============================================================ 02 work -->
  <section id="work" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#work').num}</span>
      <span class="rail__slug">{mark('#work').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{home.workHeading}</h2>
      <div class="grid">
        {
          leadWork.map((e, i) => (
            <WorkCard
              href={e.href}
              num={String(i + 1).padStart(2, '0')}
              client={e.client}
              kind={e.kind}
              problem={e.problem}
              src={e.src}
              alt={e.alt}
              ratio={e.ratio}
              year={e.year}
            />
          ))
        }
        {
          work.map((e: any, i: number) => (
            <WorkCard
              href={`/work/${e.slug}/`}
              num={String(leadWork.length + i + 1).padStart(2, '0')}
              client={e.client}
              kind={e.kind}
              problem={e.problem}
              image={e.hero}
              year={e.year}
            />
          ))
        }
        {
          tailWork.map((e, i) => (
            <WorkCard
              href={e.href}
              num={String(leadWork.length + work.length + i + 1).padStart(2, '0')}
              client={e.client}
              kind={e.kind}
              problem={e.problem}
              src={e.src}
              alt={e.alt}
              ratio={e.ratio}
              year={e.year}
            />
          ))
        }
      </div>

      <RichText value={home.workMore} class="quiet more" />

      <!-- sites, as opposed to campaigns -->
      <div class="shipped">
        <p class="mono shipped__head faint">Also built and shipped</p>
        <ul class="shipped__list">
          {
            shipped.map((s) => (
              <li class="shipped__row">
                <a class="shipped__link" href={s.href} rel="noopener">
                  {s.label}
                  <span aria-hidden="true"> ↗</span>
                </a>
                <span class="shipped__note quiet">{s.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- =========================================================== 03 films -->
  <section id="films" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#films').num}</span>
      <span class="rail__slug">{mark('#films').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{headingFor('#films', 'AI Filmmaking Workflows')}</h2>
      <p class="films__lede">
        Three original shorts. I wrote, designed, directed and cut all three of them inside a
        generative pipeline, and the sheet or the beat map behind each one is here in full.
      </p>

      <div class="grid">
        {
          films.map((f, i) => (
            <WorkCard
              href={`/films/${f.slug}/`}
              num={String(i + 1).padStart(2, '0')}
              client={f.title}
              kind="Original"
              year={f.runtime}
              problem={f.standfirst}
              src={f.poster}
              alt={f.posterAlt}
              ratio="16 / 9"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================================================= 04 product -->
  <section id="product" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#product').num}</span>
      <span class="rail__slug">{mark('#product').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{headingFor('#product', specPage.heading)}</h2>
      <p class="spec__flag mono">{specPage.flag}</p>
      <p class="spec__lede">
        {
          fill(specPage.lede, {
            brands: Words(specBrands.length),
            count: specBrands.reduce((n: number, b: any) => n + b.shots.length, 0),
          })
        }
      </p>

      <ul class="shelf">
        {
          specBrands.map((b: any) => {
            // Three brands show the studio frame beside the creator frame. The
            // rest keep their single image until their pair is supplied.
            const pair = pairFor(b.name);
            return (
              <li class={pair ? 'shelf__brand shelf__brand--pair' : 'shelf__brand'}>
                <a class="shelf__link" href={`/product/#${b.id}`}>
                  {pair ? (
                    <span class="pair">
                      <Frame
                        src={pair.product.key}
                        alt={pair.product.alt}
                        num={b.num}
                        ratio="4 / 5"
                        sizes="(max-width: 620px) 45vw, 24vw"
                      />
                      <Frame
                        src={pair.ugc.key}
                        alt={pair.ugc.alt}
                        ratio="4 / 5"
                        sizes="(max-width: 620px) 45vw, 24vw"
                      />
                    </span>
                  ) : (
                    b.shots[0] && (
                      <Frame
                        image={b.shots[0]}
                        num={b.num}
                        ratio="4 / 5"
                        sizes="(max-width: 620px) 45vw, (max-width: 1000px) 30vw, 22vw"
                      />
                    )
                  )}
                  <span class="shelf__name">{b.name}</span>
                </a>
                <p class="shelf__what mono mono--lower faint">
                  {pair ? 'Product / UGC' : b.product}
                </p>
                <p class="shelf__proves quiet">{b.proves}</p>
              </li>
            );
          })
        }
      </ul>

      <p class="quiet more">
        Every frame, the arguments in full and the gate each brand was built to break.
        <a href="/product/">Open the product shelf</a>.
      </p>
    </div>
  </section>

  <!-- ======================================================== 05 captures -->
  <section id="captures" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#captures').num}</span>
      <span class="rail__slug">{mark('#captures').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">Photoreal captures</h2>
      <p class="caps__lede">
        Generated human frames, kept for one reason each. A face at rest is the easiest thing
        these models make. Skin under unflattering daylight, hands doing skilled work, two people
        with a real eyeline between them and wet ground throwing the light back up are not, and
        those are what is on this shelf.
      </p>

      <ul class="caps">
        {
          captureLead.map((c, i) => (
            <li class="cap">
              <Frame
                src={c.key}
                alt={c.alt}
                num={String(i + 1).padStart(2, '0')}
                focus={c.focus}
                ratio="4 / 3"
                sizes="(max-width: 700px) 90vw, 42vw"
              />
              <p class="cap__title">{c.title}</p>
              <p class="cap__proves quiet">{c.proves}</p>
            </li>
          ))
        }
      </ul>

      <p class="quiet more">
        Every frame is generated and labelled as generated.
        <a href="/captures/">See all {counts.frames}</a>, with what each one was built to break.
      </p>
    </div>
  </section>

  <!-- ======================================================= 06 pipelines -->
  <section id="pipelines" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#pipelines').num}</span>
      <span class="rail__slug">{mark('#pipelines').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{headingFor('#pipelines', home.pipelinesHeading)}</h2>
      <p class="pipes__intro">
        {Words(allPipelines.length)} of these are written down, each with its stages, the tool
        behind each stage, and the control gates that stop a frame from shipping. This is the line
        behind the product shelf above.
      </p>

      <Strip {...lead} />

      <!-- the other six -->
      <aside class="more-pipes">
        <p class="mono more-pipes__head">The other {words(restOfPipelines.length)}</p>
        <ol class="more-pipes__list">
          {
            restOfPipelines.map((p: any) => (
              <li>
                <a class="more-pipes__row" href={`/pipelines/${p.id}/`}>
                  <span class="more-pipes__num mono">{p.num}</span>
                  <span class="more-pipes__title">{p.title}</span>
                  <span class="more-pipes__mech mono mono--lower faint">{p.mechanism}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="quiet more">
          <a href="/pipelines/">All {words(allPipelines.length)} in full</a>, stages, prompts and
          gates included.
        </p>
      </aside>
    </div>
  </section>

  <!-- ========================================================= 07 writing -->
  <section id="writing" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#writing').num}</span>
      <span class="rail__slug">{mark('#writing').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{home.writingHeading}</h2>
      <p class="write__lede">
        Published in full, not offered on request. Scripts keep their direction column, feed
        writing is set as text and never photographed off a phone, and the long form is described
        by the argument it had to carry.
      </p>

      <div class="feature">
        {
          featuredWriting.map((s) => (
            <article class="feature__card">
              <a class="feature__link" href={`/writing/${s.slug}/`}>
                <p class="feature__meta mono">
                  <span class={s.kind === 'Client work' ? 'feature__kind' : 'feature__kind feature__kind--spec'}>
                    {s.kind}
                  </span>
                  <span class="faint" aria-hidden="true"> · </span>
                  <span class="faint">{s.year}</span>
                </p>
                <h3 class="feature__title">{s.title}</h3>
              </a>
              <p class="feature__stand quiet">{s.standfirst}</p>
              <p class="feature__format mono mono--lower faint">{s.format}</p>
            </article>
          ))
        }
      </div>

      <ul class="write">
        {
          restOfWriting.map((s) => (
            <li>
              <a class="write__row" href={`/writing/${s.slug}/`}>
                <span class="write__title">{s.title}</span>
                <span class="write__stand quiet">{s.standfirst}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <!-- the writing that lives on the studio's own domain -->
      <div class="blog">
        <p class="mono blog__flag">{blog.flag}</p>
        <h3 class="blog__title">{blog.title}</h3>
        <p class="blog__stand quiet">{blog.standfirst}</p>
        <p class="blog__note quiet">{blog.note}</p>
        <a class="blog__link mono" href={blog.href} rel="noopener">
          {blog.linkLabel}
          <span aria-hidden="true"> ↗</span>
        </a>
      </div>

      <p class="quiet more">
        <a href="/writing/">Open the writing shelf</a>. All {counts.samples} samples, in
        {' '}{words(writingGroups.length)} groups, each one published whole.
      </p>
    </div>
  </section>

  <!-- =========================================================== 08 about -->
  <section id="about" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#about').num}</span>
      <span class="rail__slug">{mark('#about').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">{home.aboutHeading}</h2>

      <div class="about__prose">
        <RichText value={home.aboutBody} />
      </div>

      <p class="about__off quiet">
        {site.base}. Off duty it goes on {profile.offDuty.slice(0, -1).join(', ')} and
        {' '}{profile.offDuty.at(-1)}, roughly in that order and rarely in that proportion.
      </p>

      <ul class="contact">
        <li><a class="btn mono" href={`mailto:${site.email}`}>Email me</a></li>
        {
          site.cv && (
            <li>
              <a class="btn btn--ghost mono" href={site.cv} download>
                Download CV<span aria-hidden="true"> ↓</span>
              </a>
            </li>
          )
        }
        {
          site.studio?.href && (
            <li>
              <a class="btn btn--ghost mono" href={site.studio.href} rel="noopener">
                {site.studio.label}
                <span aria-hidden="true"> ↗</span>
              </a>
            </li>
          )
        }
      </ul>

      <WhatsApp class="about__wa" />
    </div>
  </section>

  <!-- ============================================================= 09 faq -->
  <section id="faq" class="section shell spread">
    <div class="rail">
      <span class="rail__num">{mark('#faq').num}</span>
      <span class="rail__slug">{mark('#faq').rail}</span>
    </div>

    <div class="stack-block">
      <h2 class="sec__h2">Questions</h2>
      <ul class="faq">
        {
          faqs.map((f, i) => (
            <li>
              <details class="faq__item" open={i === 0}>
                <summary class="faq__q">
                  <span>{f.q}</span>
                  <span class="faq__sign" aria-hidden="true">+</span>
                </summary>
                <p class="faq__a quiet">{f.a}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* --- 00 open ------------------------------------------------------------ */

  .open {
    padding-top: var(--s-8);
    padding-bottom: var(--s-7);
  }

  /* Two lines: what the person does, then where they are. They used to share a
     line with a slash between them, which put the location at the end of a
     seventy-eight character label where it read as an afterthought. */
  .open__slug {
    font-size: 0.66rem;
    max-width: none;
    margin-bottom: var(--s-6);
    display: grid;
    gap: 0.3rem;
    justify-items: start;
    color: var(--fg-quiet);
  }

  .open__role {
    color: var(--newsprint-dim);
  }

  /* Headline left, one trained creator on the right, so the first screen
     carries a picture as well as a claim. */
  .open__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 19rem);
    gap: var(--s-6);
    align-items: end;
  }

  .open__line {
    font-size: var(--step-5);
    letter-spacing: -0.03em;
    max-width: 17ch;
    margin-bottom: var(--s-5);
  }

  @media (max-width: 900px) {
    .open__top {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }
    .open__face {
      max-width: 15rem;
    }
  }

  .open__lede {
    font-size: var(--step-1);
    line-height: 1.42;
    max-width: 44ch;
    color: var(--newsprint-dim);
  }

  /* Where a reader asks it: under the description, in the same register as the
     other labels on the page, and quiet enough that it does not compete with
     the claim under it. */
  .open__base {
    color: var(--fg-faint);
  }

  /* The positioning line. Set against a rule rather than in a box, because it
     is a claim about the person and boxes make claims look like features. */
  .open__claim {
    margin-top: var(--s-4);
    padding-left: var(--s-4);
    border-left: 2px solid var(--cyan);
    font-family: var(--display);
    font-size: var(--step-0);
    line-height: 1.4;
    color: var(--newsprint);
    max-width: 46ch;
  }

  .open__note {
    margin-top: var(--s-4);
    font-size: var(--step--1);
    max-width: 46ch;
  }

  /* --- the contents index ------------------------------------------------- */

  .toc {
    margin-top: var(--s-7);
    border-top: 1px solid var(--rule-bright);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 15rem) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-3);
    min-height: var(--tap);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  /* A red bar that runs the width of the row on hover. This is the one place
     the page raises its voice. */
  .toc__row::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 0;
    background: var(--red);
    transition: width 340ms var(--ease);
  }

  .toc__row:hover::after,
  .toc__row:focus-visible::after {
    width: 100%;
  }

  .toc__num {
    color: var(--red);
    font-size: 0.66rem;
  }

  .toc__label {
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--newsprint);
    transition: color var(--dur) var(--ease);
  }

  .toc__row:hover .toc__label {
    color: var(--cyan);
  }

  .toc__note {
    font-size: 0.66rem;
    max-width: none;
  }

  @media (max-width: 760px) {
    .toc__row {
      grid-template-columns: 2.2rem minmax(0, 1fr);
      gap: 0.15rem var(--s-3);
      padding-block: var(--s-3);
    }
    .toc__num {
      grid-row: span 2;
    }
    .toc__note {
      grid-column: 2;
    }
  }

  /* --- shared section furniture ------------------------------------------- */

  .stack-block {
    display: grid;
    gap: var(--s-5);
    min-width: 0;
  }

  .sec__h2 {
    font-family: var(--mono);
    font-variation-settings: var(--rec-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
    font-weight: 500;
  }

  .more {
    font-size: var(--step--1);
  }

  /* --- 01 reel ------------------------------------------------------------ */

  .reel {
    display: block;
    position: relative;
    text-decoration: none;
  }

  .reel__trio {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
  }

