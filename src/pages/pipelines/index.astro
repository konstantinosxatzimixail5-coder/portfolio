---
import Base from '../../layouts/Base.astro';
import { getSettings, getAllPipelines, HOME_PIPELINE } from '../../lib/content';
import { breadcrumbs, collection, graph, person } from '../../lib/schema';
import { words, Words } from '../../lib/text';

const [site, pipelines] = await Promise.all([getSettings(), getAllPipelines()]);

const title = `${Words(pipelines.length)} pipelines, stage by stage | ${site.name}`;
const description =
  'Brand voice at volume, one idea split across three feeds, synthetic creators, one article turned into nine assets, product stills, episodic continuity and the operating layer underneath. Stages, tools and the control gates that stop a frame shipping.';

const jsonLd = graph([
  person(site.domain, site),
  collection(site.domain, '/pipelines/', 'Pipelines', description),
  breadcrumbs(site.domain, [
    { name: 'Home', path: '/' },
    { name: 'Pipelines', path: '/pipelines/' },
  ]),
  {
    '@type': 'ItemList',
    numberOfItems: pipelines.length,
    itemListElement: pipelines.map((p: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.title,
      description: p.summary,
      url: new URL(`/pipelines/${p.id}/`, site.domain).href,
    })),
  },
]);
---

<Base title={title} description={description} active="pipelines" jsonLd={jsonLd}>
  <article class="lines">
    <header class="lines__head shell">
      <p class="mono lines__flag">Pipelines</p>
      <h1 class="lines__title">{Words(pipelines.length)} lines, written down</h1>
      <p class="lines__lede">
        Each one is a document with a revision number on it: the mechanism, six stages, what runs
        every stage and how long it takes, the prompts the line loads, and the control gates that
        stop a frame from shipping. The tools are named. So are the ways each line fails.
      </p>
      <p class="lines__note quiet">
        One of them sits on the front page in full, because {words(pipelines.length)} is more than
        anyone reads standing up. All {words(pipelines.length)} are here.
      </p>
    </header>

    <nav class="lines__list shell" aria-label="Pipelines">
      <ol class="rows">
        {
          pipelines.map((p: any) => (
            <li>
              <a class="row" href={`/pipelines/${p.id}/`}>
                <span class="row__num mono">{p.num}</span>
                <span class="row__body">
                  <span class="row__title">{p.title}</span>
                  <span class="row__mech mono mono--lower faint">{p.mechanism}</span>
                  <span class="row__summary quiet">{p.summary}</span>
                </span>
                {p.id === HOME_PIPELINE && (
                  <span class="row__flag mono" aria-label="Shown in full on the front page">
                    On the front page
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <nav class="lines__back shell" aria-label="Back">
      <a class="mono" href="/#pipelines">← Back to the front page</a>
    </nav>
  </article>
</Base>

<style>
  .lines__head {
    padding-top: var(--s-8);
    padding-bottom: var(--s-6);
    display: grid;
    gap: var(--s-3);
  }

  .lines__flag {
    color: var(--cyan);
    font-size: 0.68rem;
    max-width: none;
  }

  .lines__title {
    font-size: var(--step-5);
    letter-spacing: -0.03em;
  }

  .lines__lede {
    font-size: var(--step-1);
    line-height: 1.42;
    max-width: 52ch;
    color: var(--newsprint-dim);
  }

  .lines__note {
    font-size: var(--step--1);
    max-width: 56ch;
  }

  .lines__list {
    padding-bottom: var(--s-8);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-bright);
  }

  .row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--s-4);
    padding-block: var(--s-4);
    min-height: var(--tap);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .row::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 0;
    background: var(--cyan);
    transition: width 340ms var(--ease);
  }

  .row:hover::after,
  .row:focus-visible::after {
    width: 100%;
  }

  .row__num {
    color: var(--cyan);
    font-size: 0.7rem;
    padding-top: 0.35rem;
  }

  .row__body {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .row__title {
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1.1;
    color: var(--newsprint);
    transition: color var(--dur) var(--ease);
  }

  .row:hover .row__title {
    color: var(--cyan);
  }

  .row__mech {
    font-size: 0.66rem;
  }

  .row__summary {
    font-size: var(--step--1);
    line-height: 1.5;
    max-width: 62ch;
    margin-top: 0.15rem;
  }

  .row__flag {
    font-size: 0.58rem;
    color: var(--gold);
    border: 1px solid var(--gold);
    border-radius: var(--radius);
    padding: 0.2rem var(--s-2);
    white-space: nowrap;
    margin-top: 0.4rem;
  }

  @media (max-width: 700px) {
    .row {
      grid-template-columns: 2.2rem minmax(0, 1fr);
      gap: 0.15rem var(--s-3);
    }
    .row__num {
      grid-row: span 2;
    }
    .row__flag {
      grid-column: 2;
      justify-self: start;
      margin-top: var(--s-2);
    }
  }

  .lines__back {
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .lines__back a {
    text-decoration: none;
    font-size: 0.68rem;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
