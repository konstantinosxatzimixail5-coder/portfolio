    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  /* min() is doing real work here. A bare minmax(19rem, 1fr) cannot shrink
     below 19rem, and 19rem is wider than the content column at 320px, so the
     section pushed the page sideways. */
  .locks {
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
  }

  .lock {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-4);
    background: var(--ink-sunk);
