    cursor: pointer;
  }

  .panel__copy:hover {
    color: var(--ink);
    background: var(--cyan);
    border-color: var(--cyan);
  }

  .panel__copy[data-state='done'] {
    color: var(--ink);
    background: var(--mint);
    border-color: var(--mint);
  }

  .panel__text {
    margin: 0;
    padding: var(--s-4);
    font-family: var(--mono);
    font-variation-settings: var(--rec-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--newsprint-dim);
    white-space: pre-wrap;
    overflow-wrap: break-word;
    overflow: auto;
  }

  /* --- pipeline stages ---------------------------------------------------- */

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--s-4);
  }

  .stage {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-4);
    background: var(--ink-raised);
    border: 1px solid var(--rule);
    border-top: 2px solid var(--cyan);
    border-radius: var(--radius);
  }

  .stage__num {
    color: var(--cyan);
    font-size: 0.66rem;
    max-width: none;
  }

  .stage__name {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--newsprint);
  }

  .stage__tool {
    font-size: 0.64rem;
    color: var(--mint);
    max-width: none;
  }

  .stage__body {
    font-size: var(--step--1);
