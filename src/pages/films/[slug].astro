    line-height: 1.5;
  }

  /* --- look --------------------------------------------------------------- */

  .look {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--rule);
  }

  .look__row {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }

  .look__row dt {
