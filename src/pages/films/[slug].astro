---
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import ShotSheet from '../../components/ShotSheet.astro';
import DocReader from '../../components/DocReader.astro';
import { getSettings, films } from '../../lib/content';
import { docExists } from '../../lib/docs';
import { breadcrumbs, graph, person } from '../../lib/schema';

export function getStaticPaths() {
  return films.map((film) => ({ params: { slug: film.slug }, props: { film } }));
}

const { film } = Astro.props;
const site = await getSettings();

const title = `${film.title}, an original short | ${site.name}`;
const description = film.logline;

// The process document is committed, so the reader renders. docExists keeps the
// section honest if the file is ever moved or dropped.
const hasDoc = docExists(film.doc.path);

const jsonLd = graph([
  person(site.domain, site),
  {
    '@type': 'CreativeWork',
    '@id': new URL(`/films/${film.slug}/`, site.domain).href + '#film',
    name: film.title,
    description: film.logline,
    url: new URL(`/films/${film.slug}/`, site.domain).href,
    genre: 'Original short, self-initiated',
    inLanguage: 'en',
    creator: { '@id': new URL('/', site.domain).href + '#person' },
    keywords: [...film.tools, ...film.skills].map((t) => t.name).join(', '),
    // The document is the evidence for everything on the page, so it is named
    // in the data as well as linked at the foot of it.
    ...(hasDoc
      ? { associatedMedia: { '@type': 'MediaObject', contentUrl: new URL(film.doc.path, site.domain).href, encodingFormat: 'application/pdf', name: film.doc.title } }
      : {}),
  },
  breadcrumbs(site.domain, [
    { name: 'Home', path: '/' },
    { name: 'Films', path: '/#films' },
    { name: film.title, path: `/films/${film.slug}/` },
  ]),
]);
---

<Base title={title} description={description} active="films" jsonLd={jsonLd}>
  <article class="film">
    <!-- 1. hero -->
    <header class="film__hero">
      <div class="film__plate">
        <Frame src={film.hero} alt={film.heroAlt} sizes="100vw" loading="eager" />
      </div>

      <div class="shell film__head">
        <p class="mono film__flag">
          Original short
          <span class="faint" aria-hidden="true"> · </span>
          <span class="faint">{film.runtime}</span>
        </p>
        <h1 class="film__title">{film.title}</h1>
        <p class="film__strap">{film.strapline}</p>
        <p class="film__logline">{film.logline}</p>

        <dl class="specrow">
          {
            film.spec.map((row) => (
              <div class="specrow__cell">
                <dt class="mono">{row.key}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <!-- 2. the film -->
    <section class="film__sec shell spread" id="the-film">
      <div class="rail">
        <span class="rail__num">01</span>
        <span class="rail__slug">The film</span>
      </div>
      <div class="film__col">
        <h2 class="film__h2">The film</h2>
        <p class="film__lede">
          The spine was beaten out with the tig-scene-engine skill before a single frame was
          generated. A short cut still needs a chain, otherwise it is only a reel of pretty motion.
        </p>

        <dl class="spine">
          {
            film.spine.map((row) => (
              <div class="spine__row">
                <dt class="mono">{row.key}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>

        <p class="pullquote">{film.spineNote}</p>

        <dl class="delivery">
          {
            film.delivery.map((row) => (
              <div class="delivery__row">
                <dt class="mono">{row.key}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- 3. beat map -->
    <section class="film__sec shell spread" id="beat-map">
      <div class="rail">
        <span class="rail__num">02</span>
        <span class="rail__slug">Beat map</span>
      </div>
      <div class="film__col">
        <h2 class="film__h2">Beat map</h2>
        <p class="film__lede">
          {film.beats.length} generation blocks, cut internally where the model was asked for a hard
          cut.
        </p>
        <ol class="beatmap">
          {
            film.beats.map((b) => (
              <li>
                <a class="beatmap__row" href={`#block-${b.letter.toLowerCase()}`}>
                  <span class="beatmap__letter mono">{b.letter}</span>
                  <span class="beatmap__time mono faint">{b.time}</span>
                  <span class="beatmap__name">{b.name}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 4. cast and world -->
    <section class="film__sec shell spread" id="cast">
      <div class="rail">
        <span class="rail__num">03</span>
        <span class="rail__slug">Cast</span>
      </div>
      <div class="film__col">
        <h2 class="film__h2">Cast and world</h2>
        <p class="film__lede">{film.castIntro}</p>
        <ul class="cast">
          {
            film.cast.map((c) => (
              <li class="cast__item">
                {c.image && c.alt && (
                  <Frame src={c.image} alt={c.alt} sizes="(max-width: 700px) 90vw, 30vw" />
                )}
                <p class="cast__tag mono">{c.tag}</p>
                <p class="cast__name">{c.name}</p>
              </li>
            ))
          }
        </ul>
        <p class="film__note mono">{film.castNote}</p>
      </div>
    </section>

    <!-- 4b. the route, Skyrunner only -->
    {
      film.route && (
        <section class="film__sec shell" id="route">
          <div class="film__routehead">
            <h2 class="film__h2">The route</h2>
            <p class="film__lede">
              The one step that made the flight read as a flight, and the only stage of the whole
              build that left the screen.
            </p>
          </div>

          <figure class="route">
            <Frame src={film.route.image} alt={film.route.alt} sizes="100vw" />
            <figcaption class="route__cap mono mono--lower faint">{film.route.caption}</figcaption>
          </figure>

          <div class="route__body">
            <div class="route__why">
              <p class="mono route__h">Why draw on the plate</p>
              {film.route.why.map((para) => (
                <p class="route__p">{para}</p>
              ))}

              <p class="mono route__h">How it is written into the prompt</p>
              <div class="panel panel--code">
                <div class="panel__bar">
                  <span class="panel__label mono">Position reference</span>
                  <button class="panel__copy mono" type="button" data-copy hidden>
                    Copy
                  </button>
                </div>
                <pre class="panel__text" data-prompt>{film.route.positionReference}</pre>
              </div>
            </div>

            <div class="route__order">
              <p class="mono route__h">Waypoint order</p>
              <ol class="waypoints">
                {film.route.waypoints.map((w) => (
                  <li class="waypoint">
                    <span class="waypoint__num mono">{w.num}</span>
                    <span class="waypoint__body">
                      <span class="waypoint__name">{w.name}</span>
                      <span class="waypoint__cue mono mono--lower faint">{w.cue}</span>
                    </span>
                  </li>
                ))}
              </ol>

              <p class="mono route__h">Locks</p>
              <ul class="route__locks">
                {film.route.locks.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            </div>
          </div>

          <p class="pullquote">{film.route.result}</p>
        </section>
      )
    }

    <!-- 5. pipeline -->
    <section class="film__sec shell spread" id="pipeline">
      <div class="rail">
        <span class="rail__num">04</span>
        <span class="rail__slug">Pipeline</span>
      </div>
      <div class="film__col">
        <h2 class="film__h2">Pipeline</h2>
        <p class="film__lede">From beat sheet to graded cut, inside one chat window.</p>
        <ol class="stages">
          {
            film.pipeline.map((stage) => (
              <li class="stage">
                <p class="stage__num mono">{stage.num}</p>
                <p class="stage__name">{stage.name}</p>
                <p class="stage__tool mono mono--lower">{stage.tool}</p>
                <p class="stage__body quiet">{stage.body}</p>
              </li>
            ))
          }
        </ol>
        <p class="film__note mono">{film.pipelineNote}</p>
      </div>
    </section>

    <!-- 6. the stack -->
    <section class="film__sec shell spread" id="stack">
      <div class="rail">
        <span class="rail__num">05</span>
        <span class="rail__slug">Stack</span>
      </div>
      <div class="film__col">
        <h2 class="film__h2">The stack</h2>
        <p class="film__lede">Four tools, three custom skills, one operator.</p>

        <ul class="tools">
          {
            film.tools.map((t) => (
              <li class="tool">
                <p class="tool__name">{t.name}</p>
                <p class="tool__role mono">{t.role}</p>
                <p class="tool__body quiet">{t.body}</p>
              </li>
            ))
          }
        </ul>

        <p class="mono film__sub">Custom Claude skills</p>
        <ul class="tools">
          {
            film.skills.map((t) => (
              <li class="tool tool--skill">
                <p class="tool__name tool__name--mono">{t.name}</p>
                <p class="tool__role mono">{t.role}</p>
                <p class="tool__body quiet">{t.body}</p>
              </li>
            ))
          }
        </ul>

        <p class="pullquote">{film.stackNote}</p>
      </div>
    </section>

    <!-- 7. shot sheets -->
    <section class="film__sec shell spread" id="shots">
      <div class="rail">
        <span class="rail__num">06</span>
        <span class="rail__slug">Shot sheets</span>
      </div>
      <div class="film__col">
        <h2 class="film__h2">Shot sheets</h2>
        <p class="film__lede">
          One block per generation, each with the still it produced and the prompt that made it, as
          written for Seedance 2.0 and built with the cinedance skill. Every prompt is here in full.
        </p>

        <div class="shots">
          {
            film.beats.map((b) => (
              <ShotSheet
                id={`block-${b.letter.toLowerCase()}`}
                letter={b.letter}
                time={b.span}
                name={b.name}
                image={b.image}
                alt={b.alt}
                note={b.note}
                prompt={b.prompt}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- 8. the look -->
    <section class="film__sec shell spread" id="look">
      <div class="rail">
        <span class="rail__num">07</span>
        <span class="rail__slug">Look</span>
      </div>
      <div class="film__col">
        <h2 class="film__h2">The look</h2>
        <p class="film__lede">
          What was asked for every time, so that {film.beats.length} blocks read as one film.
        </p>
        <dl class="look">
          {
            film.look.map((row) => (
              <div class="look__row">
                <dt class="mono">{row.key}</dt>
                <dd>
                  {row.lines.map((line) => (
                    <span class="look__line">{line}</span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="pullquote">{film.lookNote}</p>
      </div>
    </section>

    <!-- 9. locks -->
    <section class="film__sec shell spread" id="locks">
      <div class="rail">
        <span class="rail__num">08</span>
        <span class="rail__slug">Locks</span>
      </div>
      <div class="film__col">
        <h2 class="film__h2">Locks and quality control</h2>
        <p class="film__lede">
          The failure modes that cost generations, and the instruction that closed each one.
        </p>
        <ul class="locks">
          {
            film.locks.map((l) => (
              <li class="lock">
                <p class="lock__name">{l.name}</p>
                <p class="lock__row">
                  <span class="lock__key mono">Symptom</span>
                  <span class="lock__val">{l.symptom}</span>
                </p>
                <p class="lock__row">
                  <span class="lock__key mono lock__key--fix">Lock</span>
                  <span class="lock__val">{l.lock}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- closing frame -->
    <div class="film__closing shell">
      <Frame src={film.closing} alt={film.closingAlt} sizes="100vw" />
    </div>

    <!-- 10. the process document -->
    {
      hasDoc && (
        <section class="film__sec shell spread" id="process">
          <div class="rail">
            <span class="rail__num">09</span>
            <span class="rail__slug">Process</span>
          </div>
          <div class="film__col">
            <DocReader
              path={film.doc.path}
              title={film.doc.title}
              summary={film.doc.summary}
              poster={film.strip}
              posterAlt={film.stripAlt}
              shape="a set of eleven wide-format sheets"
              id="process-doc"
            />
          </div>
        </section>
      )
    }

    <nav class="film__back shell" aria-label="Back">
      <a class="mono" href="/#films">← Both films</a>
    </nav>
  </article>
</Base>

<style>
  /* --- hero --------------------------------------------------------------- */

  .film__plate {
    width: 100%;
  }

  .film__plate :global(.frame__plate) {
    border-left: 0;
    border-right: 0;
    border-radius: 0;
  }

  .film__head {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    display: grid;
    gap: var(--s-3);
  }

  .film__flag {
    color: var(--red);
    font-size: 0.68rem;
    max-width: none;
  }

  .film__title {
    font-size: var(--step-5);
    letter-spacing: -0.03em;
  }

  .film__strap {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--newsprint);
    max-width: 40ch;
  }

  .film__logline {
    font-size: var(--step-1);
    line-height: 1.42;
    max-width: 52ch;
    color: var(--newsprint-dim);
  }

  .specrow {
    margin: var(--s-3) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--s-4);
    border-top: 1px solid var(--rule);
    padding-top: var(--s-4);
  }

  .specrow__cell dt {
    font-size: 0.62rem;
    color: var(--fg-faint);
    margin-bottom: 0.2rem;
  }

  .specrow__cell dd {
    margin: 0;
    font-size: var(--step--1);
    color: var(--newsprint);
    line-height: 1.4;
  }

  /* --- shared section furniture ------------------------------------------- */

  .film__sec {
    padding-block: var(--s-7);
    border-top: 1px solid var(--rule);
  }

  /* The route section runs the full content column instead of the rail layout,
     because the map is the argument and it needs the width. */
  #route {
    display: grid;
    gap: var(--s-5);
  }

  .film__col {
    display: grid;
    gap: var(--s-4);
    min-width: 0;
  }

  .film__h2 {
    font-family: var(--mono);
    font-variation-settings: var(--rec-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-faint);
    font-weight: 500;
  }

  .film__lede {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--newsprint-dim);
    max-width: 60ch;
  }

  .film__sub {
    font-size: 0.64rem;
    color: var(--mint);
    max-width: none;
    margin-top: var(--s-3);
  }

  /* The all-caps straplines the sheets set under a block. They are the
     document's own voice, so they keep its register. */
  .film__note {
    font-size: 0.62rem;
    color: var(--fg-faint);
    max-width: none;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  /* The sheets pull one line out of each page and set it large. Worth keeping:
     it is the sentence that says what the page was for. */
  .pullquote {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.36;
    color: var(--newsprint);
    max-width: 44ch;
    padding-left: var(--s-5);
    border-left: 2px solid var(--red);
  }

  /* --- delivery ----------------------------------------------------------- */

  .delivery {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .delivery__row dt {
    font-size: 0.62rem;
    color: var(--fg-faint);
    margin-bottom: 0.2rem;
  }

  .delivery__row dd {
    margin: 0;
    font-size: var(--step--1);
    color: var(--newsprint-dim);
    line-height: 1.4;
  }

  /* --- spine -------------------------------------------------------------- */

  .spine {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--rule);
  }

  .spine__row {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }

  .spine__row dt {
    color: var(--red);
    font-size: 0.64rem;
    padding-top: 0.2rem;
  }

  .spine__row dd {
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--newsprint);
  }

  @media (max-width: 620px) {
    .spine__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }

  /* --- beat map ----------------------------------------------------------- */

  .beatmap {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-bright);
  }

  .beatmap__row {
    display: grid;
    grid-template-columns: 2rem 3.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-3);
    padding-block: var(--s-3);
    min-height: var(--tap);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .beatmap__row::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 0;
    background: var(--red);
    transition: width 340ms var(--ease);
  }

  .beatmap__row:hover::after,
  .beatmap__row:focus-visible::after {
    width: 100%;
  }

  .beatmap__letter {
    color: var(--red);
    font-size: 0.72rem;
  }

  .beatmap__time {
    font-size: 0.66rem;
  }

  .beatmap__name {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--newsprint);
    transition: color var(--dur) var(--ease);
  }

  .beatmap__row:hover .beatmap__name {
    color: var(--cyan);
  }

  /* --- cast --------------------------------------------------------------- */

  .cast {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--s-4);
  }

  .cast__item {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-4);
    background: var(--ink-sunk);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    min-width: 0;
  }

  .cast__tag {
    font-size: 0.66rem;
    color: var(--mint);
    text-transform: none;
    letter-spacing: 0.02em;
    max-width: none;
  }

  .cast__name {
    font-family: var(--display);
    font-size: var(--step-0);
    line-height: 1.25;
    color: var(--newsprint);
  }

  .cast__note {
    font-size: var(--step--1);
    line-height: 1.5;
  }

  /* --- route -------------------------------------------------------------- */

  .film__routehead {
    display: grid;
    gap: var(--s-3);
  }

  .route {
    margin: 0;
    display: grid;
    gap: var(--s-2);
  }

  .route__cap {
    font-size: 0.7rem;
  }

  .route__body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
  }

  @media (max-width: 900px) {
    .route__body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }
  }

  .route__why,
  .route__order {
    display: grid;
    gap: var(--s-3);
    min-width: 0;
  }

  .route__h {
    font-size: 0.64rem;
    color: var(--gold);
    max-width: none;
  }

  .route__h + .route__h,
  .route__p + .route__h {
    margin-top: var(--s-3);
  }

  .route__p {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--newsprint-dim);
    max-width: var(--measure);
  }

  .waypoints {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .waypoint {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    gap: var(--s-3);
    align-items: baseline;
    padding: var(--s-3) var(--s-4);
    background: var(--ink-sunk);
    border: 1px solid var(--rule);
    border-left: 2px solid var(--gold);
    border-radius: var(--radius);
  }

  .waypoint__num {
    color: var(--gold);
    font-size: 0.72rem;
  }

  .waypoint__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .waypoint__name {
    font-family: var(--display);
    font-size: var(--step-0);
    line-height: 1.2;
    color: var(--newsprint);
  }

  .waypoint__cue {
    font-size: 0.64rem;
  }

  .route__locks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .route__locks li {
    position: relative;
    padding-left: var(--s-4);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--fg-quiet);
  }

  .route__locks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 1px;
    background: var(--gold);
  }

  /* --- the position reference panel, same object as a shot prompt --------- */

  .panel {
    background: var(--ink-sunk);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .panel--code {
    border-left: 2px solid var(--cyan);
    overflow: hidden;
  }

  .panel__bar {
