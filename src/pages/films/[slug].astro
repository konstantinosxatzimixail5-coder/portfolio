  }

  .tool__name {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--newsprint);
  }

  /* A skill is a directory name, so it is set as one. */
  .tool__name--mono {
    font-family: var(--mono);
    font-variation-settings: var(--rec-mono);
    font-size: 0.9rem;
    letter-spacing: 0.01em;
  }

  .tool__role {
