---
import { getSettings } from '../lib/content';

const settings = await getSettings();

// Built once as a static file, so this is the year of the build. That is the
// only year a static page can honestly claim.
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell foot__inner">
    <p class="mono foot__mark">{settings.monogram}</p>
    {settings.footerNote && <p class="mono foot__note faint">{settings.footerNote}</p>}
    <p class="mono foot__note faint">© {year} {settings.name}</p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--rule);
    padding-block: var(--s-6);
    margin-top: var(--s-8);
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    align-items: baseline;
  }

  .foot__mark {
    color: var(--red);
    margin-right: auto;
  }

  .foot__note {
    font-size: 0.66rem;
    margin: 0;
    max-width: none;
  }
</style>
