---
import Frame from './Frame.astro';
import type { CmsImage } from '../lib/sanity';

interface Props {
  href: string;
  num: string;
  client: string;
  // Free text, because the shelves that use this card label their work
  // differently: case studies say Client, the product shelf says spec, the film
  // section says Original. The one rule is that the label is always printed.
  kind: string;
  problem: string;
  // Either a picture from the CMS, or a manifest key and its alt text for the
  // pictures this repository owns. Frame takes the same pair either way.
  image?: CmsImage | null;
  src?: string;
  alt?: string;
  year?: string;
  // The card crops to 4:3 by default so the work grid lines up. A caller with a
  // picture that is not a photograph, such as a contact strip, passes its own.
  ratio?: string;
}

const {
  href,
  num,
  client,
  kind,
  problem,
  image,
  src,
  alt,
  year,
  ratio = '4 / 3',
} = Astro.props;

// Gold is the shelf colour for anything self-initiated, and both the product
// shelf and the film section are.
const spec = /spec|original/i.test(kind);
---

<a class="card" href={href}>
  <Frame
    image={image}
    src={src}
    alt={alt}
    num={num}
    ratio={ratio}
    sizes="(max-width: 900px) 100vw, 45vw"
  />

  <div class="card__body">
    <p class="card__meta mono">
      <span class="card__client">{client}</span>
      <span class="card__sep" aria-hidden="true">·</span>
      <span class={spec ? 'card__kind card__kind--spec' : 'card__kind'}>{kind}</span>
      {
        year && (
          <>
            <span class="card__sep" aria-hidden="true">
              ·
            </span>
            <span class="faint">{year}</span>
          </>
        )
      }
    </p>
    <p class="card__problem">{problem}</p>
  </div>
</a>

<style>
  .card {
    display: grid;
    gap: var(--s-3);
    text-decoration: none;
    color: inherit;
    padding-bottom: var(--s-2);
  }

  .card :global(.frame__plate) {
    transition: border-color var(--dur) var(--ease);
  }

  .card :global(.frame__plate img) {
    transition:
      transform 600ms var(--ease),
      filter var(--dur) var(--ease);
    filter: saturate(0.92);
  }

  .card:hover :global(.frame__plate) {
    border-color: var(--cyan);
  }

  .card:hover :global(.frame__plate img) {
    transform: scale(1.03);
    filter: saturate(1.05);
  }

  .card__body {
    display: grid;
    gap: var(--s-2);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: baseline;
    font-size: 0.66rem;
    margin: 0;
    max-width: none;
  }

  .card__client {
    color: var(--newsprint);
  }

  .card__sep {
    color: var(--fg-faint);
  }

  .card__kind {
    color: var(--cyan);
  }

  .card__kind--spec {
    color: var(--gold);
  }

  .card__problem {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.28;
    max-width: 30ch;
    color: var(--newsprint);
  }

  .card:hover .card__problem {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover :global(.frame__plate img) {
      transform: none;
    }
  }
</style>
