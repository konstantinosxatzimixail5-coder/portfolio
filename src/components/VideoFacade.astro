---
// Click-to-play facade. The poster frame is a static image. No third-party
// iframe, cookie or script loads until someone presses play.
//
// The budget in the README is three embeds site wide, four at the outside, and
// it is about embeds, not players: an embed is a script running on page load,
// and there are none of those here. Twelve of these can sit on a site and the
// page weight does not move until a visitor decides it should.
import Frame from './Frame.astro';
import type { Film } from '../content/video';

interface Props {
  film: Film;
  loading?: 'lazy' | 'eager';
}

const { film, loading = 'lazy' } = Astro.props;
const { host, videoId, poster, title, duration, ratio = '16:9' } = film;

if (!poster) {
  throw new Error(
    `VideoFacade: "${title}" has a video id but no poster frame. Add one in the Studio, or the player has nothing to sit behind.`
  );
}

const embed =
  host === 'vimeo'
    ? `https://player.vimeo.com/video/${videoId}?autoplay=1&dnt=1&title=0&byline=0&portrait=0`
    : `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1`;

const watch =
  host === 'vimeo' ? `https://vimeo.com/${videoId}` : `https://www.youtube.com/watch?v=${videoId}`;

const tall = ratio === '9:16';
---

<div
  class={tall ? 'facade facade--tall' : 'facade'}
  data-facade
  data-embed={embed}
  data-title={title}
  data-ratio={tall ? '9 / 16' : '16 / 9'}
>
  <Frame
    image={poster}
    loading={loading}
    ratio={tall ? '9 / 16' : '16 / 9'}
    sizes={tall ? '(max-width: 620px) 90vw, 22rem' : '(max-width: 900px) 100vw, 80vw'}
  />

  <button type="button" class="facade__btn" data-play>
    <span class="facade__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
        <path d="M8 5.2v13.6L19 12z"></path>
      </svg>
    </span>
    <span class="facade__label">
      <span class="facade__play mono">Play</span>
      <span class="facade__title">{title}</span>
    </span>
    {duration && <span class="facade__dur mono">{duration}</span>}
  </button>

  <noscript>
    <p class="facade__noscript">
      <a href={watch} rel="noopener">Watch {title} on {host === 'vimeo' ? 'Vimeo' : 'YouTube'}</a>
    </p>
  </noscript>
</div>

<style>
  .facade {
    position: relative;
    display: grid;
  }

  /* A vertical cut at full column width is a wall of picture. Held to a phone's
     worth of width and left-aligned, it reads as what it is: something made for
     a feed. */
  .facade--tall {
    max-width: 22rem;
  }

  .facade :global(.frame) {
    grid-area: 1 / 1;
  }

  .facade__btn {
    grid-area: 1 / 1;
    z-index: 2;
    -webkit-appearance: none;
    appearance: none;
    border: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--ink) 82%, transparent) 0%,
      color-mix(in srgb, var(--ink) 20%, transparent) 45%,
      transparent 100%
    );
    color: var(--newsprint);
    cursor: pointer;
    display: flex;
    align-items: flex-end;
    gap: var(--s-4);
    padding: var(--s-5);
    text-align: left;
    width: 100%;
    height: 100%;
    border-radius: var(--radius);
    transition: background var(--dur) var(--ease);
  }

  .facade__icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--cyan);
    color: var(--ink);
    transition:
      transform var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .facade__btn:hover .facade__icon {
    transform: scale(1.07);
    background: var(--newsprint);
  }

  .facade__label {
    display: grid;
    gap: 0.15rem;
    margin-right: auto;
    min-width: 0;
  }

  .facade__play {
    color: var(--cyan);
    font-size: 0.66rem;
  }

  .facade__title {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .facade--tall .facade__title {
    font-size: var(--step-0);
  }

  .facade__dur {
    flex: 0 0 auto;
    color: var(--newsprint);
    font-size: 0.68rem;
    align-self: flex-end;
    padding-bottom: 0.35rem;
  }

  .facade__noscript {
    grid-area: 1 / 1;
    align-self: end;
    z-index: 3;
    padding: var(--s-5);
  }

  @media (max-width: 620px) {
    .facade__btn {
      padding: var(--s-4);
      gap: var(--s-3);
    }
    .facade__icon {
      width: 46px;
      height: 46px;
    }
    .facade__dur {
      display: none;
    }
  }

  .facade__iframe {
    grid-area: 1 / 1;
    width: 100%;
    aspect-ratio: var(--facade-ratio, 16 / 9);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-facade]').forEach((facade) => {
    const btn = facade.querySelector<HTMLButtonElement>('[data-play]');
    const embed = facade.dataset.embed;
    const title = facade.dataset.title ?? 'Video';
    if (!btn || !embed) return;

    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.className = 'facade__iframe';
      // The player keeps the shape of the poster it replaced, so a vertical cut
      // does not snap to widescreen and letterbox itself the moment it starts.
      iframe.style.setProperty('--facade-ratio', facade.dataset.ratio ?? '16 / 9');
      iframe.src = embed;
      iframe.title = title;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('loading', 'lazy');
      facade.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
