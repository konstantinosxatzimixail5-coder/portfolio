# Copy to studio/.env and fill in. Anything named SANITY_STUDIO_* is compiled
# into the Studio bundle and is therefore public. Never put a token in here.

# Same project id as the site's .env. Filled in rather than blank for the same
# reason: it is public, it is in every Studio URL, and leaving it empty only ever
# cost somebody five minutes finding it again.
SANITY_STUDIO_PROJECT_ID=y9oyffjn
SANITY_STUDIO_DATASET=production
